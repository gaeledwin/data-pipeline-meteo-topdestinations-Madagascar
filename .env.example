# DockerHub image
DOCKERHUB_NAMESPACE==your_dockerhub_namespace
DOCKERHUB_REPOSITORY=meteo_mada_data_api

# Postgres connection - POSTGRES_CONN_USERNAME set to the default postgres user to not create another db
POSTGRES_CONN_USERNAME=wheater_user
POSTGRES_CONN_PASSWORD="change_me"
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432

# Metadata database credentials
METADATA_DATABASE_NAME=airflow_metadata_db
METADATA_DATABASE_USERNAME=airflow_meta_user
METADATA_DATABASE_PASSWORD="change_me"

# Celery database credentials
CELERY_BACKEND_NAME=celery_results_db
CELERY_BACKEND_USERNAME=celery_user
CELERY_BACKEND_PASSWORD="change_me"

# ELT database credentials
ETL_DATABASE_NAME=etl_db
ETL_DATABASE_USERNAME=wheater_api_user
ETL_DATABASE_PASSWORD="change_me"

# Airflow params 
AIRFLOW_UID="50000"
AIRFLOW_WWW_USER_USERNAME="airflow"
AIRFLOW_WWW_USER_PASSWORD="change_me"
FERNET_KEY=generate_your_own_with_python_cryptography_fernet

# wheater params

WEATHER_API_KEY=your_weather_api_key